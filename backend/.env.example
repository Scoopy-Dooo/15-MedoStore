# البيئة (development, production, staging)
NODE_ENV=development

# منفذ الخادم
PORT=5000

# قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/medo_store?schema=public"

# أسرار JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Origins (Frontend URLs)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# إعدادات البريد الإلكتروني
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Medo Store <noreply@medostore.com>

# رقم واتساب
WHATSAPP_NUMBER=249908180432

# بوابة الدفع (سيتم إضافتها لاحقاً)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# Upload limits
MAX_FILE_SIZE=5242880
MAX_FILES=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin credentials (first setup)
ADMIN_EMAIL=admin@medostore.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Logs
LOG_LEVEL=info
